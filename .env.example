# Runtime mode is required. Use dev, test, staging, or prod.
ENV=dev

DATABASE_URL=postgresql+psycopg2://actiflow:change-me@127.0.0.1:5432/actiflow
TEST_DATABASE_URL=postgresql+psycopg2://actiflow:change-me@127.0.0.1:5432/actiflow_test

# Generate a unique secret of at least 32 characters for staging/production.
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
ENABLE_DEBUG_ROUTES=false

# Comma-separated. Staging/production must use explicit HTTPS origins.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_BASE_URL=http://localhost:3000

RESEND_API_KEY=
RESEND_FROM_EMAIL=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_BASE_URL=
